        "type": "layout",
        "pages": [
            "window-settings"
        ],
        "window-settings": {
            "type": "page",
            "title": "Windows",
            "sections": ["window-section"]
        },
        "window-section": {
            "type": "section",
            "title": "window arrangement",
            "keys": ["arrangeKeybinding", "focusKeybinding", "moveKeybinding", "swapKeybinding"]
