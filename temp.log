        }

//animations part

 "animationsAllowed": {
        "type": "checkbox",
        "default": "true",
        "description": "Animations allowed"
    },
    "animationType": {
        "type": "combobox",
        "default": "linear",
        "description": "Type of animation to apply",
        "options": {
            "Linear": "linear"
        },
        "dependency": "animationsAllowed"
    },
    "animationTime": {
        "type": "scale",
        "default": 0.25,
        "min": 0.01,
        "max": 5,
        "step": 0.01,
        "description": "Duration of animation",
        "dependency": "animationsAllowed"
    }

