class KeyHandler {
  keyMap;
  // settingsMap;
  // settings;
  constructor() {
    eventMgr = Events.EventManager.instance; //assign to global object
    //loads the keyMap from settings
    // this.arrangeKeybinding = null;
    this.keyMap = MAP; //has keys to event mapping
    // this.settingsMap = {};
    for (const [key, _] of Object.entries(this.keyMap)) {
      this[key] = null;
      // global.log("key is ", key);
    }

    let settings = new Settings.ExtensionSettings(this, UUID);
    global.log("settings is ", JSON.stringify(settings));
    // for (const [key, _] of Object.entries(this.keyMap)) {
    //     global.log("key is", key, typeof(key))
    //     settings.bindProperty(
    //         Settings.BindingDirection.IN,
    //         key,
    //         key,
    //         () => this.updateKeybinding(key),
    //         null,
    //     );
    // }
    settings.bindProperty(
      Settings.BindingDirection.IN,
      "arrangeKeybinding",
      "arrangeKeybinding",
      () => {
        (global.log("Executed #########"), null);
      },
    );
    global.log("after bind property");
    // this.updateAllKeyBindings();
  }
  // updateEvent(key, eventCallback) {
  //     if (!this.keyMap[key]) {
  //         DEBUG.print(
  //             ` ${UUID} : FAILED TO UPDATE EVENT : Error in key map - value is `,
  //             this.keyMap,
  //         );
  //         return;
  //     }
  //     this.keyMap[key].event = eventCallback;
  //     this.updateKeybinding(key);
  // }
  updateKeybinding(key) {
    if (this.keyMap[key] && this[key].length > 0) {
      global.log(
        "added key binding for key = ",
        key,
        " and value = ",
        this[key],
      );
      Main.keybindingManager.addHotKey(this.keyMap[key].id, this[key], () => {
        GLib.timeout_add(GLib.PRIORITY_DEFAULT, EVENT_GAP, () => {
          global.log("will this work??");
          this.keyMap[key].event();
          return GLib.SOURCE_REMOVE;
        });
      });
    }
  }

  // updateAllKeyBindings() {
  //     for (const [key, _] of Object.entries(this.settingsMap)) {
  //         this.updateKeybinding(key);
  //     }
  // }
  destroyKey(key) {
    if (!this.keyMap[key]) {
      DEBUG.Print(
        ` ${UUID} : FAILED TO DESTORY KEYHANLDER : Error in key map : KEY=${key} NOT FOUND!!! - value is `,
        this.keyMap,
      );
    }
    Main.keybindingManager.removeHotKey(this.keyMap[key].id);
  }
  destroy() {
    for (const [key, _] of Object.entries(this.keyMap)) {
      this.destroyKey(key);
    }
    eventMgr.destroy();
    eventMgr = null;
  }
}

