{
    "layout": {
        "type": "layout",
        "pages": ["window-settings", "animation-settings"],
        "window-settings": {
            "type": "page",
            "title": "Windows",
            "sections": ["window-section", "workspace-section"]
        },
        "window-section": {
            "type": "section",
            "title": "window arrangement",
            "keys": [
                "arrangeKeyBinding",
                "focusKeyBinding",
                "moveKeyBinding",
                "swapKeyBinding",
                "halfScreenBinding",
                "fullScreenBinding",
                "unmaximizeBinding",
                "minimizeBinding"
            ]
        },
        "workspace-section": {
            "type": "section",
            "title": "Workspace arrangement",
            "keys": ["moveSwitchWorkspace1Binding",
                "moveSwitchWorkspace2Binding"
            ]
        },
        "animation-settings": {
            "type": "page",
            "title": "Animations",
            "sections": ["animation-section"]
        },
        "animation-section": {
            "type": "section",
            "title": "Animation Settings",
            "keys": ["animationsAllowed", "animationTime", "animationType"]
        }
    },
    "arrangeKeyBinding": {
        "type": "keybinding",
        "description": "Arrange Windows Shortcut",
        "default": "<Super>Tab"
    },
    "focusKeyBinding": {
        "type": "keybinding",
        "description": "Focus Window Shortcut",
        "default": "<Super>f"
    },
    "moveKeyBinding": {
        "type": "keybinding",
        "description": "Move Window Shortcut",
        "default": "<Super>m"
    },
    "swapKeyBinding": {
        "type": "keybinding",
        "description": "Swap Window Shortcut",
        "default": "<Super>s"
    },
    "halfScreenBinding": {
        "type": "keybinding",
        "description": "Make the focused window occupy half size",
        "default": "<Super>h"
    },
    "fullScreenBinding": {
        "type": "keybinding",
        "description": "Maximize the focused window",
        "default": "<Super>l"
    },
    "unmaximizeBinding": {
        "type": "keybinding",
        "description": "Exit from the maximized window",
        "default": "<Super>q"
    },
    "minimizeBinding": {
        "type": "keybinding",
        "description": "Minimize the focused window",
        "default": "<Super>p"
    },
    "animationsAllowed": {
        "type": "checkbox",
        "default": true,
        "description": "Animations"
    },
    "animationTime": {
        "type": "scale",
        "default": 0.25,
        "min": 0.01,
        "max": 5,
        "step": 0.01,
        "description": "Duration"
    },
    "animationType": {
        "type": "combobox",
        "description": "Type",
        "default": "linear",
        "options": {
            "Linear": "linear"
        }
    },
    "moveSwitchWorkspace1Binding": {
        "type": "keybinding",
        "description": "move the focused window to workspace 1",
        "default": "<Super><Shift>1"
    },
    "moveSwitchWorkspace2Binding": {
        "type": "keybinding",
        "description": "move the focused window to workspace 2",
        "default": "<Super><Shift>2"
    }
}